# Copy to .env and replace each example credential before deployment.
# Use URL-safe characters in POSTGRES_PASSWORD because Compose embeds it in the Airflow URI.
POSTGRES_USER=project_user
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password
POSTGRES_DB=industrial_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
AIRFLOW_DB_NAME=airflow

# Generate a Fernet key for real deployments; this value is only an example.
AIRFLOW_ADMIN_USERNAME=airflow_admin
AIRFLOW_ADMIN_PASSWORD=replace-with-a-unique-airflow-password
AIRFLOW_ADMIN_EMAIL=admin@example.invalid
AIRFLOW_FERNET_KEY=replace-with-generated-fernet-key
AIRFLOW_WEBSERVER_SECRET_KEY=replace-with-a-long-random-secret

PGADMIN_DEFAULT_EMAIL=pgadmin@example.invalid
PGADMIN_DEFAULT_PASSWORD=replace-with-a-unique-pgadmin-password

API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
LOG_LEVEL=INFO
